<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CaptureCheckMode Condition="'$(FrameSource)' != ''">source</CaptureCheckMode>
    <CaptureCheckMode Condition="'$(FrameSource)' == ''">published</CaptureCheckMode>
    <OutputPath>bin/$(CaptureCheckMode)/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/$(CaptureCheckMode)/$(Configuration)/</IntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(FrameSource)' == ''">
    <Reference Include="EasyCon2.CLI.PreviewV5"><HintPath>$(EasyConDir)/EasyCon2.CLI.PreviewV5.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(FrameSource)' != ''">
    <Compile Include="$(FrameSource)" Link="ProductionSynchronizedFrameSource.cs" />
  </ItemGroup>
</Project>
