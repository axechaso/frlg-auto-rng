diff --git a/src/EasyCon2.CLI/MjpegPreviewServer.cs b/src/EasyCon2.CLI/MjpegPreviewServer.cs
new file mode 100644
index 0000000..a824994
--- /dev/null
+++ b/src/EasyCon2.CLI/MjpegPreviewServer.cs
@@ -0,0 +1,209 @@
+using System.Collections.Concurrent;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+
+internal readonly record struct MjpegPreviewFrame(long Sequence, byte[] Jpeg);
+
+internal sealed class MjpegPreviewServer : IAsyncDisposable
+{
+    private const string Boundary = "easycon-frame";
+    private readonly int _port;
+    private readonly Func<MjpegPreviewFrame?> _frameProvider;
+    private readonly CancellationTokenSource _stop = new();
+    private readonly ConcurrentDictionary<int, Task> _clients = new();
+    private TcpListener? _listener;
+    private Task? _listenTask;
+    private int _nextClientId;
+
+    public MjpegPreviewServer(int port, Func<MjpegPreviewFrame?> frameProvider)
+    {
+        if (port is < 1 or > 65535)
+            throw new ArgumentOutOfRangeException(nameof(port));
+        _port = port;
+        _frameProvider = frameProvider;
+    }
+
+    public void Start()
+    {
+        if (_listener is not null)
+            return;
+
+        var listener = new TcpListener(IPAddress.Loopback, _port);
+        listener.Start();
+        _listener = listener;
+        _listenTask = Task.Run(() => ListenAsync(listener, _stop.Token));
+    }
+
+    private async Task ListenAsync(TcpListener listener, CancellationToken token)
+    {
+        while (!token.IsCancellationRequested)
+        {
+            TcpClient client;
+            try
+            {
+                client = await listener.AcceptTcpClientAsync(token);
+            }
+            catch (OperationCanceledException)
+            {
+                break;
+            }
+            catch (SocketException) when (token.IsCancellationRequested)
+            {
+                break;
+            }
+            catch (ObjectDisposedException) when (token.IsCancellationRequested)
+            {
+                break;
+            }
+
+            var clientId = Interlocked.Increment(ref _nextClientId);
+            var task = HandleAsync(client, token);
+            _clients[clientId] = task;
+            _ = task.ContinueWith(
+                completedTask =>
+                {
+                    _ = completedTask;
+                    _clients.TryRemove(clientId, out _);
+                },
+                CancellationToken.None,
+                TaskContinuationOptions.ExecuteSynchronously,
+                TaskScheduler.Default);
+        }
+    }
+
+    private static async Task<string?> ReadPathAsync(
+        NetworkStream stream,
+        CancellationToken token)
+    {
+        var request = new byte[8192];
+        var length = 0;
+        while (length < request.Length)
+        {
+            var read = await stream.ReadAsync(request.AsMemory(length), token);
+            if (read == 0)
+                return null;
+            length += read;
+            var text = Encoding.ASCII.GetString(request, 0, length);
+            if (!text.Contains("\r\n\r\n", StringComparison.Ordinal))
+                continue;
+            var firstLineEnd = text.IndexOf("\r\n", StringComparison.Ordinal);
+            var firstLine = firstLineEnd >= 0 ? text[..firstLineEnd] : text;
+            var parts = firstLine.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+            return parts.Length >= 2 && parts[0] == "GET" ? parts[1] : null;
+        }
+        return null;
+    }
+
+    private async Task HandleAsync(TcpClient client, CancellationToken token)
+    {
+        using (client)
+        {
+            client.NoDelay = true;
+            try
+            {
+                var stream = client.GetStream();
+                var path = await ReadPathAsync(stream, token);
+                if (path == "/health")
+                {
+                    await WriteTextResponseAsync(stream, "200 OK", "ok\n", token);
+                    return;
+                }
+                if (path != "/mjpeg")
+                {
+                    await WriteTextResponseAsync(stream, "404 Not Found", "not found\n", token);
+                    return;
+                }
+
+                var responseHeaders = Encoding.ASCII.GetBytes(
+                    "HTTP/1.1 200 OK\r\n" +
+                    "Connection: close\r\n" +
+                    "Cache-Control: no-store, no-cache, must-revalidate\r\n" +
+                    "Pragma: no-cache\r\n" +
+                    $"Content-Type: multipart/x-mixed-replace; boundary={Boundary}\r\n\r\n");
+                await stream.WriteAsync(responseHeaders, token);
+
+                var boundary = Encoding.ASCII.GetBytes($"--{Boundary}\r\n");
+                var frameEnding = Encoding.ASCII.GetBytes("\r\n");
+                long sentSequence = 0;
+                while (!token.IsCancellationRequested)
+                {
+                    MjpegPreviewFrame? frame;
+                    try
+                    {
+                        frame = _frameProvider();
+                    }
+                    catch
+                    {
+                        frame = null;
+                    }
+                    if (frame is null || frame.Value.Sequence == sentSequence)
+                    {
+                        await Task.Delay(20, token);
+                        continue;
+                    }
+
+                    var jpeg = frame.Value.Jpeg;
+                    var frameHeaders = Encoding.ASCII.GetBytes(
+                        $"Content-Type: image/jpeg\r\nContent-Length: {jpeg.Length}\r\n\r\n");
+                    await stream.WriteAsync(boundary, token);
+                    await stream.WriteAsync(frameHeaders, token);
+                    await stream.WriteAsync(jpeg, token);
+                    await stream.WriteAsync(frameEnding, token);
+                    await stream.FlushAsync(token);
+                    sentSequence = frame.Value.Sequence;
+                    await Task.Delay(66, token);
+                }
+            }
+            catch (OperationCanceledException) when (token.IsCancellationRequested)
+            {
+            }
+            catch (IOException)
+            {
+            }
+            catch (SocketException)
+            {
+            }
+            catch (ObjectDisposedException)
+            {
+            }
+        }
+    }
+
+    private static async Task WriteTextResponseAsync(
+        NetworkStream stream,
+        string status,
+        string body,
+        CancellationToken token)
+    {
+        var payload = Encoding.UTF8.GetBytes(body);
+        var headers = Encoding.ASCII.GetBytes(
+            $"HTTP/1.1 {status}\r\nConnection: close\r\n" +
+            $"Content-Type: text/plain; charset=utf-8\r\nContent-Length: {payload.Length}\r\n\r\n");
+        await stream.WriteAsync(headers, token);
+        await stream.WriteAsync(payload, token);
+    }
+
+    public async ValueTask DisposeAsync()
+    {
+        _stop.Cancel();
+        var listener = _listener;
+        listener?.Stop();
+
+        if (_listenTask is not null)
+        {
+            try
+            {
+                await _listenTask;
+            }
+            catch (OperationCanceledException)
+            {
+            }
+        }
+
+        var clients = _clients.Values.ToArray();
+        if (clients.Length > 0)
+            await Task.WhenAll(clients);
+        _stop.Dispose();
+    }
+}
