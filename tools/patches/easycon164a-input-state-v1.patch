+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Linq;
+using System.Text.Json.Serialization;
+using System.Threading;
+
+namespace EasyDevice;
+
+public static class InputStateBuffer
+{
+    private const int Capacity = 512;
+    private static readonly long StartedAt = Stopwatch.GetTimestamp();
+    private static readonly ConcurrentQueue<InputTransition> History = new();
+    private static long _sequence;
+    private static InputTransition? _latest;
+    private static InputStateIdentity? _identity;
+    private static string _connection = "unknown";
+
+    public static void Configure(string runId, string sessionId, string stageId, string source)
+    {
+        if (string.IsNullOrWhiteSpace(runId) || string.IsNullOrWhiteSpace(sessionId) ||
+            string.IsNullOrWhiteSpace(stageId))
+            throw new ArgumentException("Input state identity must not be empty");
+        if (source is not ("device_report" or "mock"))
+            throw new ArgumentException("Input state source is invalid", nameof(source));
+
+        while (History.TryDequeue(out _)) { }
+        Interlocked.Exchange(ref _sequence, 0);
+        Volatile.Write(ref _latest, new InputTransition(0, 0, InputReport.Neutral));
+        Volatile.Write(ref _connection, "unknown");
+        Volatile.Write(ref _identity, new InputStateIdentity(runId, sessionId, stageId, source));
+    }
+
+    public static void SetConnection(string state)
+    {
+        if (state is not ("connected" or "disconnected" or "error" or "unknown"))
+            throw new ArgumentException("Input state connection is invalid", nameof(state));
+        Volatile.Write(ref _connection, state);
+    }
+
+    public static void Publish(ushort button, byte hat, byte lx, byte ly, byte rx, byte ry)
+    {
+        var snapshot = new InputReport(button, hat, lx, ly, rx, ry);
+        var previous = Volatile.Read(ref _latest);
+        if (previous is not null && previous.Snapshot == snapshot)
+        {
+            Volatile.Write(ref _connection, "connected");
+            return;
+        }
+
+        var sequence = Interlocked.Increment(ref _sequence);
+        var transition = new InputTransition(
+            sequence,
+            (long)Stopwatch.GetElapsedTime(StartedAt).TotalMilliseconds,
+            snapshot);
+        Volatile.Write(ref _latest, transition);
+        History.Enqueue(transition);
+        while (History.Count > Capacity)
+            History.TryDequeue(out _);
+        Volatile.Write(ref _connection, "connected");
+    }
+
+    public static InputStateResponse Read(long afterSequence, bool deviceConnected)
+    {
+        var identity = Volatile.Read(ref _identity)
+            ?? new InputStateIdentity("", "", "", "device_report");
+        var latest = Volatile.Read(ref _latest);
+        var history = History.ToArray();
+        var firstSequence = history.Length == 0 ? (latest?.Sequence ?? 0) + 1 : history[0].Sequence;
+        var gap = afterSequence < firstSequence - 1;
+        if (history.Length > 256 && afterSequence < history[^256].Sequence - 1)
+            gap = true;
+        var events = gap
+            ? Array.Empty<InputStateEventPayload>()
+            : history
+                .Where(item => item.Sequence > afterSequence)
+                .TakeLast(256)
+                .Select(item => new InputStateEventPayload(
+                    item.Sequence, item.AtMs, ToPayload(item.Snapshot)))
+                .ToArray();
+
+        return new InputStateResponse(
+            1,
+            identity.RunId,
+            identity.SessionId,
+            identity.StageId,
+            (long)Stopwatch.GetElapsedTime(StartedAt).TotalMilliseconds,
+            latest?.Sequence ?? 0,
+            identity.Source,
+            Volatile.Read(ref _connection) == "error"
+                ? "error"
+                : deviceConnected ? "connected" : "disconnected",
+            ToPayload(latest?.Snapshot ?? InputReport.Neutral),
+            events,
+            gap);
+    }
+
+    private static InputStateSnapshotPayload ToPayload(InputReport report)
+    {
+        var buttons = Enum.GetValues<SwitchButton>()
+            .Where(button => (report.Button & (ushort)button) != 0)
+            .Select(button => button.ToString())
+            .ToArray();
+        var hat = ((SwitchHAT)report.Hat) switch
+        {
+            SwitchHAT.TOP => "TOP",
+            SwitchHAT.TOP_RIGHT => "TOP_RIGHT",
+            SwitchHAT.RIGHT => "RIGHT",
+            SwitchHAT.BOTTOM_RIGHT => "DOWN_RIGHT",
+            SwitchHAT.BOTTOM => "DOWN",
+            SwitchHAT.BOTTOM_LEFT => "DOWN_LEFT",
+            SwitchHAT.LEFT => "LEFT",
+            SwitchHAT.TOP_LEFT => "TOP_LEFT",
+            _ => "CENTER",
+        };
+        return new InputStateSnapshotPayload(
+            buttons,
+            hat,
+            [report.LX, report.LY],
+            [report.RX, report.RY]);
+    }
+
+    private sealed record InputStateIdentity(string RunId, string SessionId, string StageId, string Source);
+    private readonly record struct InputReport(ushort Button, byte Hat, byte LX, byte LY, byte RX, byte RY)
+    {
+        public static InputReport Neutral => new(
+            0, (byte)SwitchHAT.CENTER, SwitchStick.STICK_CENTER, SwitchStick.STICK_CENTER,
+            SwitchStick.STICK_CENTER, SwitchStick.STICK_CENTER);
+    }
+    private sealed record InputTransition(long Sequence, long AtMs, InputReport Snapshot);
+}
+
+public sealed record InputStateSnapshotPayload(
+    [property: JsonPropertyName("buttons")] string[] Buttons,
+    [property: JsonPropertyName("hat")] string Hat,
+    [property: JsonPropertyName("left_stick")] byte[] LeftStick,
+    [property: JsonPropertyName("right_stick")] byte[] RightStick);
+
+public sealed record InputStateEventPayload(
+    [property: JsonPropertyName("seq")] long Sequence,
+    [property: JsonPropertyName("at_ms")] long AtMs,
+    [property: JsonPropertyName("snapshot")] InputStateSnapshotPayload Snapshot);
+
+public sealed record InputStateResponse(
+    [property: JsonPropertyName("protocol")] int Protocol,
+    [property: JsonPropertyName("run_id")] string RunId,
+    [property: JsonPropertyName("session_id")] string SessionId,
+    [property: JsonPropertyName("stage_id")] string StageId,
+    [property: JsonPropertyName("server_ms")] long ServerMs,
+    [property: JsonPropertyName("seq")] long Sequence,
+    [property: JsonPropertyName("source")] string Source,
+    [property: JsonPropertyName("connection")] string Connection,
+    [property: JsonPropertyName("snapshot")] InputStateSnapshotPayload Snapshot,
+    [property: JsonPropertyName("events")] InputStateEventPayload[] Events,
+    [property: JsonPropertyName("history_gap")] bool HistoryGap);
