+    private static bool TryReadAfterSequence(string path, out long sequence)
+    {
+        sequence = 0;
+        var queryIndex = path.IndexOf('?');
+        if (queryIndex < 0)
+            return true;
+        foreach (var item in path[(queryIndex + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
+        {
+            var pair = item.Split('=', 2, StringSplitOptions.None);
+            if (Uri.UnescapeDataString(pair[0]) != "after_seq")
+                continue;
+            return pair.Length == 2 && long.TryParse(
+                Uri.UnescapeDataString(pair[1]),
+                System.Globalization.NumberStyles.None,
+                System.Globalization.CultureInfo.InvariantCulture,
+                out sequence) && sequence >= 0;
+        }
+        return true;
+    }
+
+    private static async Task WriteJsonResponseAsync(
+        NetworkStream stream,
+        string status,
+        byte[] payload,
+        CancellationToken token)
+    {
+        var headers = Encoding.ASCII.GetBytes(
+            $"HTTP/1.1 {status}\r\nConnection: close\r\n" +
+            $"Content-Type: application/json; charset=utf-8\r\nContent-Length: {payload.Length}\r\n\r\n");
+        await stream.WriteAsync(headers, token);
+        await stream.WriteAsync(payload, token);
+    }
