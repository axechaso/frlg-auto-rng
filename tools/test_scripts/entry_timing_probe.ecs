# 只观察，不发送任何按键。日美版入场标签共用。
# 先运行，再手动触发同一种宝可梦遭遇。不能从已有HP栏开始。
# 与母本保持相同阈值及WAIT100；结果仅作时差观察，不是最终出闪确认。
$探测次数上限 = 400
$探测序号 = 0
$边框匹配 = 0
$HP匹配 = 0
$空白匹配 = 0
$HP观察时间 = 0
$空白观察时间 = 0
$观察耗时 = 0
$时差观察结果 = 0

$HP匹配 = @三代路闪HP检测
IF $HP匹配 > 90
    PRINT 开始时已出现HP栏，请回到遇敌前重新运行观察脚本。
    RETURN 0
ENDIF

PRINT 入场观察已启动；请手动触发遭遇。本脚本不操作主机。
FOR $探测序号 = 1 TO $探测次数上限
    $边框匹配 = @三代路闪遇敌
    IF $边框匹配 > 90
        $HP匹配 = @三代路闪HP检测
        IF $HP匹配 > 90
            $HP观察时间 = TIME()
            WAIT 100
            $空白匹配 = @三代路闪wild检测
            $空白观察时间 = TIME()
            $观察耗时 = $空白观察时间 - $HP观察时间
            IF $空白匹配 > 96
                $时差观察结果 = 1
            ENDIF
            PRINT ENTRY_CAPTURE_PROBE|HP= & $HP匹配 & |BLANK= & $空白匹配 & |ELAPSED_MS= & $观察耗时 & |TIMING_RESULT= & $时差观察结果
            PRINT 这是入场时差观察，需与实际是否闪光对照；不替代精灵检测。
            RETURN 0
        ENDIF
    ENDIF
    WAIT 5
NEXT
PRINT 未观察到有效HP入场起点，结束观察；不判定闪光。
RETURN 0
