<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(EasyConDir)' != ''">
    <Reference Include="EasyCon.Device"><HintPath>$(EasyConDir)/EasyCon.Device.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(EasyConDir)' == ''">
    <Compile Include="$(EasyConSource)/src/EasyCon.Device/InputStateBuffer.cs" Link="InputStateBuffer.cs" />
    <Compile Include="$(EasyConSource)/src/EasyCon.Device/Utils/SwitchCommand.cs" Link="SwitchCommand.cs" />
  </ItemGroup>
</Project>
