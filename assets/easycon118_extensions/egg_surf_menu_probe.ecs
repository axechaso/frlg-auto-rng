# EasyCon 1.6.4-a 孵蛋池塘冲浪结束判定独立测试
#
# 运行前：
# 1. 进入英文版火红/叶绿游戏，在池塘岸边面朝水面；不要打开任何菜单或对话。
# 2. 保持“先执行冲浪=1”。如果人物已经在水面上，则改成0。
# 3. 本脚本只等待“冲浪 > 95”；命中后按一次 X 并停住，供人工确认菜单。
# 4. 本脚本不会发送方向键、进入队伍、抓怪或存档。

# ========================
# 用户输入
# ========================
$测试_先执行冲浪 = 1
$测试_冲浪阈值 = 95
$测试_冲浪最多采样 = 20
$测试_冲浪采样间隔MS = 500

# ========================
# 共享状态
# ========================
$测试_采样序号 = 0
$测试_冲浪分数 = 0
$测试_冲浪最小 = 101
$测试_冲浪最大 = 0
$测试_冲浪命中采样 = 0

PRINT ""
PRINT ========================
PRINT 孵蛋池塘冲浪结束判定独立测试
PRINT ========================
PRINT 说明: 冲浪标签超过95之前绝不发送X；命中后只按一次X

IF $测试_先执行冲浪 != 0 and $测试_先执行冲浪 != 1
    PRINT 配置错误: 先执行冲浪只能填写0或1
    RETURN
ENDIF
IF $测试_冲浪阈值 < 1 or $测试_冲浪阈值 > 99
    PRINT 配置错误: 冲浪阈值必须是1-99
    RETURN
ENDIF
IF $测试_冲浪最多采样 < 1 or $测试_冲浪最多采样 > 40
    PRINT 配置错误: 冲浪最多采样必须是1-40
    RETURN
ENDIF
IF $测试_冲浪采样间隔MS < 100 or $测试_冲浪采样间隔MS > 2000
    PRINT 配置错误: 冲浪采样间隔必须是100-2000ms
    RETURN
ENDIF

IF $测试_先执行冲浪 == 1
    PRINT 【冲浪测试】按正式孵蛋流程时序确认冲浪
    A
    WAIT 1200
    A
    WAIT 2000
    A
ELSE
    PRINT 【冲浪测试】人物当前已在水面上，直接检测冲浪完成标签
ENDIF

PRINT 【冲浪探测】等待冲浪完成标签；命中前绝不发送X
FOR $测试_采样序号 = 1 TO $测试_冲浪最多采样
    WAIT $测试_冲浪采样间隔MS
    $测试_冲浪分数 = @冲浪
    IF $测试_冲浪分数 < $测试_冲浪最小
        $测试_冲浪最小 = $测试_冲浪分数
    ENDIF
    IF $测试_冲浪分数 > $测试_冲浪最大
        $测试_冲浪最大 = $测试_冲浪分数
    ENDIF
    PRINT "SURF_MENU|SURF_SAMPLE|N=" & $测试_采样序号 & "|SURF=" & $测试_冲浪分数
    IF $测试_冲浪分数 > $测试_冲浪阈值
        $测试_冲浪命中采样 = $测试_采样序号
        BREAK
    ENDIF
NEXT

PRINT "SURF_MENU|SURF_SUMMARY|MIN=" & $测试_冲浪最小 & "|MAX=" & $测试_冲浪最大 & "|HIT_SAMPLE=" & $测试_冲浪命中采样
IF $测试_冲浪命中采样 == 0
    PRINT 测试结果: 冲浪完成标签始终未超过95；脚本没有发送X
    RETURN
ENDIF

PRINT 【菜单操作】冲浪已结束，现在只按一次X
PRINT "SURF_MENU|X_PRESS|SURF=" & $测试_冲浪分数
X
WAIT 2000
PRINT 测试结果: 冲浪标签已超过95并发送一次X；请人工确认菜单是否打开
PRINT 测试结束: 脚本未发送DOWN、UP、LEFT、RIGHT，也未进入队伍或抓捕
