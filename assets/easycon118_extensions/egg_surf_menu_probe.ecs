# EasyCon 1.6.4-a 孵蛋池塘冲浪菜单独立测试
#
# 运行前：
# 1. 进入英文版火红/叶绿游戏，在池塘岸边面朝水面；不要打开任何菜单或对话。
# 2. 保持“先执行冲浪=1”。如果人物已经在水面上，则改成0。
# 3. 本脚本只会确认冲浪、测试X和读取标签；不会发送方向键、进入队伍、抓怪或存档。
# 4. 测试结束时如果菜单成功打开，脚本会把菜单留在画面上，方便人工核对。

# ========================
# 用户输入
# ========================
$测试_先执行冲浪 = 1
$测试_菜单阈值 = 90
$测试_X最多尝试 = 2
$测试_每次采样数 = 12
$测试_采样间隔MS = 250

# ========================
# 共享状态
# ========================
$测试_X尝试 = 0
$测试_采样序号 = 0
$测试_箭头分数 = 0
$测试_BAG分数 = 0
$测试_箭头最小 = 101
$测试_箭头最大 = 0
$测试_BAG最小 = 101
$测试_BAG最大 = 0
$测试_BAG命中次数 = 0
$测试_成功尝试 = 0

PRINT ""
PRINT ========================
PRINT 孵蛋池塘冲浪菜单独立测试
PRINT ========================
PRINT 说明: 只测试冲浪后的X与标签，不会发送方向键或进入队伍

IF $测试_先执行冲浪 != 0 and $测试_先执行冲浪 != 1
    PRINT 配置错误: 先执行冲浪只能填写0或1
    RETURN
ENDIF
IF $测试_菜单阈值 < 1 or $测试_菜单阈值 > 100
    PRINT 配置错误: 菜单阈值必须是1-100
    RETURN
ENDIF
IF $测试_X最多尝试 < 1 or $测试_X最多尝试 > 5
    PRINT 配置错误: X最多尝试必须是1-5
    RETURN
ENDIF
IF $测试_每次采样数 < 1 or $测试_每次采样数 > 30
    PRINT 配置错误: 每次采样数必须是1-30
    RETURN
ENDIF
IF $测试_采样间隔MS < 100 or $测试_采样间隔MS > 2000
    PRINT 配置错误: 采样间隔必须是100-2000ms
    RETURN
ENDIF

IF $测试_先执行冲浪 == 1
    PRINT 【冲浪测试】按正式孵蛋流程时序确认冲浪
    A
    WAIT 1200
    A
    WAIT 2000
    A
    WAIT 5000
ELSE
    PRINT 【冲浪测试】已配置为人物当前就在水面上，跳过冲浪按键
    WAIT 1000
ENDIF

$测试_箭头分数 = @三代菜单栏
$测试_BAG分数 = @火红BAG
PRINT "SURF_MENU|BASELINE|ARROW=" & $测试_箭头分数 & "|BAG=" & $测试_BAG分数
IF $测试_BAG分数 > $测试_菜单阈值
    PRINT 测试前已经识别到BAG菜单，请关闭菜单后重新运行
    RETURN
ENDIF

PRINT 【菜单探测】开始测试X；后续不会发送任何方向键或A键
FOR $测试_X尝试 = 1 TO $测试_X最多尝试
    $测试_箭头最小 = 101
    $测试_箭头最大 = 0
    $测试_BAG最小 = 101
    $测试_BAG最大 = 0
    $测试_BAG命中次数 = 0

    PRINT "SURF_MENU|X_PRESS|ATTEMPT=" & $测试_X尝试
    X
    FOR $测试_采样序号 = 1 TO $测试_每次采样数
        WAIT $测试_采样间隔MS
        $测试_箭头分数 = @三代菜单栏
        $测试_BAG分数 = @火红BAG
        IF $测试_箭头分数 < $测试_箭头最小
            $测试_箭头最小 = $测试_箭头分数
        ENDIF
        IF $测试_箭头分数 > $测试_箭头最大
            $测试_箭头最大 = $测试_箭头分数
        ENDIF
        IF $测试_BAG分数 < $测试_BAG最小
            $测试_BAG最小 = $测试_BAG分数
        ENDIF
        IF $测试_BAG分数 > $测试_BAG最大
            $测试_BAG最大 = $测试_BAG分数
        ENDIF
        IF $测试_BAG分数 > $测试_菜单阈值
            $测试_BAG命中次数 += 1
        ENDIF
        PRINT "SURF_MENU|SAMPLE|ATTEMPT=" & $测试_X尝试 & "|N=" & $测试_采样序号 & "|ARROW=" & $测试_箭头分数 & "|BAG=" & $测试_BAG分数
    NEXT

    PRINT "SURF_MENU|SUMMARY|ATTEMPT=" & $测试_X尝试 & "|ARROW_MIN=" & $测试_箭头最小 & "|ARROW_MAX=" & $测试_箭头最大 & "|BAG_MIN=" & $测试_BAG最小 & "|BAG_MAX=" & $测试_BAG最大 & "|BAG_HITS=" & $测试_BAG命中次数
    IF $测试_BAG命中次数 > 0
        $测试_成功尝试 = $测试_X尝试
        BREAK
    ENDIF

    # 第一轮没有任何BAG命中才允许再次按X；期间仍不发送方向键。
    WAIT 1000
NEXT

PRINT ""
IF $测试_成功尝试 == 1
    PRINT 测试结果: 第一次X成功打开菜单；请人工确认画面上的BAG菜单
ELIF $测试_成功尝试 > 1
    PRINT 测试结果: 第一次X未得到BAG命中，第 & $测试_成功尝试 & "次X后识别到菜单"
ELSE
    PRINT 测试结果: 所有X尝试都没有识别到BAG菜单；请保留当前画面和完整日志
ENDIF
PRINT 测试结束: 脚本未发送DOWN、UP、LEFT、RIGHT，也未进入队伍或抓捕
