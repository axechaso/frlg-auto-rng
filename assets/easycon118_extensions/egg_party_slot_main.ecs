# GUI 孵蛋运行时覆盖：按目标身份选择队伍末位或固定槽位
FUNC 孵蛋流程_选择队伍槽($队伍位置: INT, $目标为队伍末位: INT): INT
    IF $目标为队伍末位 == 1
        # 刚抓到的野生永远位于当前队伍末位；从队首向上绕过取消按钮只需两次。
        RETURN 反查_队伍页按上移次数选择目标(2)
    ELIF $队伍位置 == 5
        # 复用普通定点的末位反查导航；蛋在第5位、复核野生在第6位，因此多按一次UP。
        RETURN 反查_队伍页按上移次数选择目标(3)
    ELIF $队伍位置 == 6
        RETURN 反查_队伍页按上移次数选择目标(2)
    ELSE
        PRINT 孵蛋队伍槽参数无效: & $队伍位置
        RETURN 0
    ENDIF
ENDFUNC

FUNC 孵蛋流程_打开指定槽能力页($队伍位置: INT, $目标为队伍末位: INT): INT
    X
    WAIT 500
    A
    WAIT 1500
    $孵蛋流程选槽结果 = 孵蛋流程_选择队伍槽($队伍位置, $目标为队伍末位)
    IF $孵蛋流程选槽结果 != 1
        RETURN 0
    ENDIF
    A
    WAIT 500
    A
    WAIT 1500
    $刚使用神奇糖果 = 0
    RETURN 1
ENDFUNC
