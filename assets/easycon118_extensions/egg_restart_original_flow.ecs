# GUI 孵蛋运行时覆盖：按 2.0 顺序关闭游戏，优先处理退出状态
FUNC 孵蛋测试_关闭游戏($识图阈值: INT): INT
    PRINT 【孵蛋准备】识图关闭游戏
    $孵蛋库_重启识别尝试 = 0
    $孵蛋库_已请求主页 = 0
    FOR
        $孵蛋库_主页匹配 = @主页
        $孵蛋库_主页NS2匹配 = @主页_NS2
        $孵蛋库_正确退出匹配 = @正确退出
        $孵蛋库_正确退出NS2匹配 = @正确退出_NS2
        $孵蛋库_HOME_BUFFER正确退出匹配 = @HOME_BUFFER正确退出
        $孵蛋库_错误退出匹配 = @错误退出
        $孵蛋库_错误退出NS2匹配 = @错误退出_NS2
        IF $孵蛋库_调试日志输出 == 1
            PRINT "孵蛋重启识图|主页=" & $孵蛋库_主页匹配 & "|主页_NS2=" & $孵蛋库_主页NS2匹配 & "|正确退出=" & $孵蛋库_正确退出匹配 & "|正确退出_NS2=" & $孵蛋库_正确退出NS2匹配 & "|HOME_BUFFER正确退出=" & $孵蛋库_HOME_BUFFER正确退出匹配 & "|错误退出=" & $孵蛋库_错误退出匹配 & "|错误退出_NS2=" & $孵蛋库_错误退出NS2匹配
        ENDIF

        # 原版关闭顺序：先处理已经显示的正确/错误退出状态，再决定是否需要 HOME。
        # 不能先按 HOME，否则会把刚进入的主页切回游戏。
        IF ($孵蛋库_正确退出匹配 >= $识图阈值 or $孵蛋库_HOME_BUFFER正确退出匹配 >= $识图阈值) or $孵蛋库_正确退出NS2匹配 >= $识图阈值
            PRINT 第一次退出正确
            X
            WAIT 1500
            A
            WAIT 1500
            FOR
                $孵蛋库_正在关闭匹配 = @正在关闭
                IF $孵蛋库_调试日志输出 == 1
                    PRINT "孵蛋重启识图|正在关闭=" & $孵蛋库_正在关闭匹配
                ENDIF
                IF $孵蛋库_正在关闭匹配 >= $识图阈值
                    WAIT 100
                ELSE
                    BREAK
                ENDIF
            NEXT
            RETURN 1
        ELIF $孵蛋库_错误退出匹配 >= $识图阈值 or $孵蛋库_错误退出NS2匹配 >= $识图阈值
            PRINT 错误进入休眠菜单
            B
            WAIT 1500
            $孵蛋库_已请求主页 = 1
            $孵蛋库_重启识别尝试 = 0
            CONTINUE
        ELIF $孵蛋库_主页匹配 >= $识图阈值 or $孵蛋库_主页NS2匹配 >= $识图阈值
            PRINT 游戏外启动
            RETURN 1
        ELSE
            IF $孵蛋库_已请求主页 == 0
                HOME 100
                WAIT 1500
                $孵蛋库_已请求主页 = 1
                IF $孵蛋库_调试日志输出 == 1
                    PRINT 孵蛋重启识图|已从游戏内请求主页，重新采样
                ENDIF
                CONTINUE
            ENDIF
            $孵蛋库_重启识别尝试 = $孵蛋库_重启识别尝试 + 1
            IF $孵蛋库_重启识别尝试 < 3
                WAIT 500
                CONTINUE
            ENDIF
            PRINT "孵蛋重启识图失败：请求主页后仍未识别主页、正确退出或错误退出"
            RETURN 0
        ENDIF
    NEXT
    RETURN 0
ENDFUNC
