# GUI 孵蛋运行时覆盖：孵化骑车前可靠退出能力页、队伍菜单和主菜单
# 本文件由 Python 替换到 1.1.8 的 lib/27_孵蛋测试流程.ecs，不单独执行。

$孵蛋库_孵化退出层 = 0

FUNC 孵蛋测试_执行骑车孵化($全国图鉴编号: INT, $周期覆盖: INT, $每循环步数: INT, $安全循环数: INT): INT
    $孵蛋库_孵化循环数 = 孵蛋测试_计算孵化循环数($全国图鉴编号, $周期覆盖, $每循环步数, $安全循环数)
    IF $孵蛋库_孵化循环数 <= 0
        PRINT 孵化循环参数无效
        RETURN 0
    ENDIF

    # 此处固定从复核野生的能力页开始。旧流程只按三次 B，且前两次只等
    # 500 ms；实机可在回到宝可梦操作菜单的转场中吞掉后续 B，接着把
    # 用于地图走位的 UP 作用在 SUMMARY 菜单上并绕到 CANCEL。
    # 五次有间隔的 B 足以逐层退出能力页、操作菜单、队伍页和主菜单；
    # 多余的 B 在野外无副作用，因此不需要冒险猜测当前具体停在哪一层。
    PRINT 【孵化准备】正在逐层退出能力页与菜单
    FOR $孵蛋库_孵化退出层 = 1 TO 5
        B
        WAIT 1500
        PRINT 孵化退出进度: & $孵蛋库_孵化退出层 & "/5"
    NEXT

    PRINT 【孵化准备】开始位置校正与骑车
    UP 200
    WAIT 850
    Y
    WAIT 1000

    FOR $孵蛋库_孵化循环索引 = 1 TO $孵蛋库_孵化循环数
        IF $孵蛋库_孵化循环索引 == 1 or $孵蛋库_孵化循环索引 % 10 == 0 or $孵蛋库_孵化循环索引 == $孵蛋库_孵化循环数
            PRINT 孵化骑车进度: & $孵蛋库_孵化循环索引 & "/" & $孵蛋库_孵化循环数
        ENDIF
        LS LEFT
        WAIT 2400
        LS RESET
        WAIT 0
        LS RIGHT
        WAIT 2400
        LS RESET
    NEXT

    # 不依赖识图；沿用取消进化的固定B键节奏跳过孵化段。
    WAIT 7500
    B
    WAIT 3000
    B
    WAIT 2000
    B
    WAIT 1500
    RETURN 1
ENDFUNC
