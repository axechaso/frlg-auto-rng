# 1.6.4-a 孵蛋前快捷登记检查：重要道具第2项必须是已登记的自行车。

FUNC 孵蛋测试_检查并登记自行车快捷($识图阈值: INT): INT
    PRINT "FRLG_STAGE|BEGIN|egg.settings.shortcut|egg.settings.shortcut|20000|lib/27_孵蛋测试流程.ecs|孵蛋测试_检查并登记自行车快捷|egg27.settings.shortcut|manual_prepare_then_restart|OR;快捷第一位.IL:>=:" & $识图阈值 & ",快捷第二位.IL:>=:" & $识图阈值 & ",快捷第三位.IL:>=:" & $识图阈值 & "|!"
    X
    WAIT 500
    FOR 2
        DOWN
        WAIT 150
    NEXT
    A
    WAIT 1500
    RIGHT
    WAIT 1500

    $孵蛋库_快捷第一分数 = @快捷第一位
    $孵蛋库_快捷第二分数 = @快捷第二位
    $孵蛋库_快捷第三分数 = @快捷第三位
    PRINT "孵蛋快捷登记识别: 第一位=" & $孵蛋库_快捷第一分数 & " 第二位=" & $孵蛋库_快捷第二分数 & " 第三位=" & $孵蛋库_快捷第三分数
    IF $孵蛋库_快捷第二分数 < $识图阈值
        DOWN
        WAIT 150
        A
        WAIT 1500
        DOWN
        WAIT 300
        A
        WAIT 1500

        $孵蛋库_快捷第二分数 = -1
        FOR $孵蛋库_快捷识别尝试 = 1 TO 3
            $孵蛋库_快捷第二分数 = @快捷第二位
            IF $孵蛋库_快捷第二分数 >= $识图阈值
                BREAK
            ENDIF
            WAIT 500
        NEXT
        IF $孵蛋库_快捷第二分数 < $识图阈值
            PRINT "FRLG_STAGE|FAIL|egg.settings.shortcut|登记自行车后第二位仍未匹配|!"
            PRINT "孵蛋快捷登记检查失败: 第二位匹配度=" & $孵蛋库_快捷第二分数
            B
            WAIT 1500
            B
            WAIT 1000
            RETURN 0
        ENDIF
        PRINT 孵蛋快捷登记已修改为重要道具第2项自行车
    ELSE
        PRINT 孵蛋快捷登记正确: 重要道具第2项自行车
    ENDIF

    B
    WAIT 1500
    B
    WAIT 1000
    PRINT "FRLG_STAGE|END|egg.settings.shortcut|!"
    RETURN 1
ENDFUNC
