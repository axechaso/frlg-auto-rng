# GUI 孵蛋运行时覆盖：识别冲浪结束后再打开菜单，并在名称 OCR 前确认已进入野生战斗
# 本文件由 Python 替换到 1.1.8 的 lib/27_孵蛋测试流程.ecs，不单独执行。

$孵蛋库_池塘战斗检测尝试 = 0
$孵蛋库_池塘野生出现匹配 = 0
$孵蛋库_池塘抓捕就绪匹配 = 0
$孵蛋库_池塘冲浪检测尝试 = 0
$孵蛋库_池塘冲浪匹配 = 0
$孵蛋库_池塘冲浪结果 = 0

FUNC 孵蛋测试_等待池塘冲浪结束(): INT
    # “冲浪”标签命中表示冲浪转场已经结束，此时才允许按 X。
    # 最多等待 10 秒，避免依赖固定 5 秒窗口，也避免转场中提前发送 X。
    FOR $孵蛋库_池塘冲浪检测尝试 = 1 TO 20
        WAIT 2500
        $孵蛋库_池塘冲浪匹配 = @冲浪
        PRINT 孵蛋池塘冲浪检测|尝试= & $孵蛋库_池塘冲浪检测尝试 & "|冲浪=" & $孵蛋库_池塘冲浪匹配
        IF $孵蛋库_池塘冲浪匹配 > 95
            RETURN 1
        ELSE
            A
        ENDIF
    NEXT
    RETURN 0
ENDFUNC

FUNC 孵蛋测试_等待池塘野生战斗(): INT
    # 正常情况下 10 秒固定等待后已经停在“野生宝可梦出现”文本。
    # 这里只等待并重采样，不盲按 A；若实际仍在地图/菜单，额外按键会让状态继续错位。
    # 仍未出现战斗标签时立即交给外层重启，禁止在非战斗画面误跑名称 OCR。
    FOR $孵蛋库_池塘战斗检测尝试 = 1 TO 4
        $孵蛋库_池塘野生出现匹配 = @野生出现
        $孵蛋库_池塘抓捕就绪匹配 = @抓捕就绪
        PRINT 孵蛋池塘战斗检测|尝试= & $孵蛋库_池塘战斗检测尝试 & "|野生出现=" & $孵蛋库_池塘野生出现匹配 & "|抓捕就绪=" & $孵蛋库_池塘抓捕就绪匹配
        IF $孵蛋库_池塘野生出现匹配 > 90 or $孵蛋库_池塘抓捕就绪匹配 > 95
            RETURN 1
        ENDIF
        WAIT 750
    NEXT
    RETURN 0
ENDFUNC

FUNC 孵蛋测试_前往池塘并甜甜香气抓捕($识图阈值: INT, $出闪后继续抓捕: INT): INT
    # 领取帧命中完成后，从老人处到池塘边的实机路线。
    IF $孵蛋库_已到池塘 == 1
        $孵蛋库_已到池塘 = 0
    ELSE
        LS DOWN
        WAIT 500
        LS RESET
        WAIT 400
        LS RIGHT
        WAIT 1500
        LS RESET
        WAIT 300
        DOWN
        WAIT 500
    ENDIF

    # 第二次与第三次 A 之间保留 2000 ms；第三次确认后改用“冲浪”标签判断转场完成。
    PRINT 【孵蛋Seed验证】确认冲浪
    A
    WAIT 1200
    A
    WAIT 2000
    A

    $孵蛋库_池塘冲浪结果 = 孵蛋测试_等待池塘冲浪结束()
    IF $孵蛋库_池塘冲浪结果 != 1
        PRINT 孵蛋池塘冲浪结束标签未命中：本轮禁止按 X 并安全重启
        RETURN -1
    ENDIF

    PRINT 【孵蛋Seed验证】冲浪结束，打开菜单并使用队首甜甜香气
    X
    WAIT 500
    DOWN
    WAIT 500
    A
    WAIT 1500
    A
    WAIT 1000
    DOWN
    WAIT 500
    A
    WAIT 10000

    $孵蛋库_启动野生战斗结果 = 孵蛋测试_等待池塘野生战斗()
    IF $孵蛋库_启动野生战斗结果 != 1
        PRINT 孵蛋池塘遭遇失败：冲浪或甜甜香气没有进入野生战斗，本轮安全重启
        RETURN -1
    ENDIF

    $孵蛋库_抓捕对象名称 = 识别抓捕对象名称优先OCR($识图阈值)
    $孵蛋库_抓捕图鉴编号 = 英文名称查图鉴编号($孵蛋库_抓捕对象名称)
    $孵蛋库_写入结果 = 写入获取结果($孵蛋库_抓捕图鉴编号, 0, $孵蛋库_抓捕对象名称)
    IF $孵蛋库_抓捕图鉴编号 <= 0
        PRINT 孵蛋Seed验证野生名称识别失败: & $孵蛋库_抓捕对象名称
        RETURN -1
    ENDIF

    $孵蛋库_出闪结果 = CheckCaptureShiny($孵蛋库_抓捕图鉴编号, $识图阈值)
    IF $孵蛋库_出闪结果 == 1 and $出闪后继续抓捕 == 0
        PRINT Seed验证遇到闪光，按配置停止自动抓捕
        RETURN -1
    ENDIF
    A
    WAIT 3000
    $孵蛋库_抓捕结果 = 扔球抓捕($孵蛋库_抓捕图鉴编号, $出闪后继续抓捕, $孵蛋库_出闪结果)
    $孵蛋库_写入结果 = 写入获取结果($孵蛋库_抓捕图鉴编号, $孵蛋库_抓捕结果, $孵蛋库_抓捕对象名称)
    RETURN $孵蛋库_抓捕结果
ENDFUNC
