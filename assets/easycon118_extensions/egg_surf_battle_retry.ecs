# GUI 孵蛋运行时覆盖：冲浪确认留足窗口，并在名称 OCR 前确认已进入野生战斗
# 本文件由 Python 替换到 1.1.8 的 lib/27_孵蛋测试流程.ecs，不单独执行。

$孵蛋库_池塘战斗检测尝试 = 0
$孵蛋库_池塘野生出现匹配 = 0
$孵蛋库_池塘抓捕就绪匹配 = 0
$孵蛋库_池塘菜单检测尝试 = 0
$孵蛋库_池塘菜单匹配 = 0
$孵蛋库_池塘主菜单结果 = 0

FUNC 孵蛋测试_可靠打开池塘主菜单(): INT
    # 冲浪转场偶发吞掉第一次 X。只有确认主菜单标签后才允许发送 DOWN，
    # 避免 DOWN 落到地图上让人物离开池塘交互位置。
    FOR $孵蛋库_池塘菜单检测尝试 = 1 TO 5
        $孵蛋库_池塘菜单匹配 = @三代菜单栏
        IF $孵蛋库_池塘菜单匹配 > 90
            PRINT 孵蛋池塘主菜单已打开|尝试= & $孵蛋库_池塘菜单检测尝试 & "|菜单=" & $孵蛋库_池塘菜单匹配
            RETURN 1
        ENDIF
        X
        WAIT 1000
        $孵蛋库_池塘菜单匹配 = @三代菜单栏
        PRINT 孵蛋池塘主菜单检测|尝试= & $孵蛋库_池塘菜单检测尝试 & "|菜单=" & $孵蛋库_池塘菜单匹配
        IF $孵蛋库_池塘菜单匹配 > 90
            RETURN 1
        ENDIF
        WAIT 500
    NEXT
    RETURN 0
ENDFUNC

FUNC 孵蛋测试_等待池塘野生战斗(): INT
    # 正常情况下 10 秒固定等待后已经停在“野生宝可梦出现”文本。
    # 这里只等待并重采样，不盲按 A；若实际仍在地图/菜单，额外按键会让状态继续错位。
    # 仍未出现战斗标签时立即交给外层重启，禁止在非战斗画面误跑名称 OCR。
    FOR $孵蛋库_池塘战斗检测尝试 = 1 TO 4
        $孵蛋库_池塘野生出现匹配 = @野生出现
        $孵蛋库_池塘抓捕就绪匹配 = @抓捕就绪
        PRINT 孵蛋池塘战斗检测|尝试= & $孵蛋库_池塘战斗检测尝试 & "|野生出现=" & $孵蛋库_池塘野生出现匹配 & "|抓捕就绪=" & $孵蛋库_池塘抓捕就绪匹配
        IF $孵蛋库_池塘野生出现匹配 > 90 or $孵蛋库_池塘抓捕就绪匹配 > 95
            RETURN 1
        ENDIF
        WAIT 750
    NEXT
    RETURN 0
ENDFUNC

FUNC 孵蛋测试_前往池塘并甜甜香气抓捕($识图阈值: INT, $出闪后继续抓捕: INT): INT
    # 领取帧命中完成后，从老人处到池塘边的实机路线。
    IF $孵蛋库_已到池塘 == 1
        $孵蛋库_已到池塘 = 0
    ELSE
        LS DOWN
        WAIT 500
        LS RESET
        WAIT 400
        LS RIGHT
        WAIT 1500
        LS RESET
        WAIT 300
        DOWN
    ENDIF

    # 原流程第二次与第三次 A 之间只有 800 ms，实机偶发在冲浪转场中吞掉第三次确认。
    PRINT 【孵蛋Seed验证】确认冲浪
    A
    WAIT 1200
    A
    WAIT 2000
    A
    WAIT 5000

    PRINT 【孵蛋Seed验证】使用队首甜甜香气
    $孵蛋库_池塘主菜单结果 = 孵蛋测试_可靠打开池塘主菜单()
    IF $孵蛋库_池塘主菜单结果 != 1
        PRINT 孵蛋池塘主菜单未打开：冲浪转场持续拒绝 X，本轮安全重启
        RETURN -1
    ENDIF
    DOWN
    WAIT 500
    A
    WAIT 1500
    A
    WAIT 1000
    DOWN
    WAIT 500
    A
    WAIT 10000

    $孵蛋库_启动野生战斗结果 = 孵蛋测试_等待池塘野生战斗()
    IF $孵蛋库_启动野生战斗结果 != 1
        PRINT 孵蛋池塘遭遇失败：冲浪或甜甜香气没有进入野生战斗，本轮安全重启
        RETURN -1
    ENDIF

    $孵蛋库_抓捕对象名称 = 识别抓捕对象名称优先OCR($识图阈值)
    $孵蛋库_抓捕图鉴编号 = 英文名称查图鉴编号($孵蛋库_抓捕对象名称)
    $孵蛋库_写入结果 = 写入获取结果($孵蛋库_抓捕图鉴编号, 0, $孵蛋库_抓捕对象名称)
    IF $孵蛋库_抓捕图鉴编号 <= 0
        PRINT 孵蛋Seed验证野生名称识别失败: & $孵蛋库_抓捕对象名称
        RETURN -1
    ENDIF

    $孵蛋库_出闪结果 = CheckCaptureShiny($孵蛋库_抓捕图鉴编号, $识图阈值)
    IF $孵蛋库_出闪结果 == 1 and $出闪后继续抓捕 == 0
        PRINT Seed验证遇到闪光，按配置停止自动抓捕
        RETURN -1
    ENDIF
    A
    WAIT 3000
    $孵蛋库_抓捕结果 = 扔球抓捕($孵蛋库_抓捕图鉴编号, $出闪后继续抓捕, $孵蛋库_出闪结果)
    $孵蛋库_写入结果 = 写入获取结果($孵蛋库_抓捕图鉴编号, $孵蛋库_抓捕结果, $孵蛋库_抓捕对象名称)
    RETURN $孵蛋库_抓捕结果
ENDFUNC
