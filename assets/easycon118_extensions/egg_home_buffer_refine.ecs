# GUI 孵蛋运行时覆盖：按当前 NX 机型细化 HOME_BUFFER 延迟
FUNC HOME_BUFFER
    $孵蛋HOME_BUFFER尝试 = 0
    $孵蛋HOME_BUFFER步长 = 100
    $孵蛋HOME_BUFFER上次方向 = 0
    $孵蛋HOME_BUFFER失败 = 0
    FOR
        $孵蛋HOME_BUFFER尝试 = $孵蛋HOME_BUFFER尝试 + 1
        IF $孵蛋HOME_BUFFER尝试 > 40
            PRINT HOME_BUFFER校准失败：40轮内未找到当前主机的可用延迟
            $孵蛋HOME_BUFFER失败 = 1
            RETURN
        ENDIF
        A
        WAIT 1500
        A
        WAIT $HOME_BUFFER延迟
        IF $调试日志输出 == 1
            PRINT 尝试HOME_BUFFER延迟: & $HOME_BUFFER延迟 & " ms"
        ENDIF
        HOME 100
        WAIT 1500
        $HOME_BUFFER当前正确退出 = @HOME_BUFFER正确退出
        $HOME_BUFFER当前正确退出_NS2 = @HOME_BUFFER正确退出_NS2
        $HOME_BUFFER当前正确退出普通 = @正确退出
        $HOME_BUFFER当前正确退出普通_NS2 = @正确退出_NS2
        $HOME_BUFFER当前错误退出 = @错误退出
        $HOME_BUFFER当前错误退出_NS2 = @错误退出_NS2

        # 只使用当前主机对应的标签。NS1 不能用 NS2 分数判定，反之亦然。
        IF $NX机型 == 1
            $孵蛋HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出
            $孵蛋HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通
            $孵蛋HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出
        ELSE
            $孵蛋HOME_BUFFER选中正确 = $HOME_BUFFER当前正确退出_NS2
            $孵蛋HOME_BUFFER选中普通 = $HOME_BUFFER当前正确退出普通_NS2
            $孵蛋HOME_BUFFER选中错误 = $HOME_BUFFER当前错误退出_NS2
        ENDIF
        IF $调试日志输出 == 1
            PRINT "HOME_BUFFER_LABEL|NX=" & $NX机型 & "|BUFFER=" & $孵蛋HOME_BUFFER选中正确 & "|NORMAL=" & $孵蛋HOME_BUFFER选中普通 & "|ERROR=" & $孵蛋HOME_BUFFER选中错误 & "|NS1_BUFFER=" & $HOME_BUFFER当前正确退出 & "|NS2_BUFFER=" & $HOME_BUFFER当前正确退出_NS2 & "|STEP=" & $孵蛋HOME_BUFFER步长
        ENDIF

        IF $孵蛋HOME_BUFFER选中正确 >= 95
            PRINT 可用HOME_BUFFER延迟: & $HOME_BUFFER延迟 & " ms"
            RETURN
        ELIF $孵蛋HOME_BUFFER选中错误 >= 95
            PRINT 错误进入休眠菜单
            B
            WAIT 1500
            CALL 关闭游戏
        ELIF $孵蛋HOME_BUFFER选中普通 >= 95
            # 过长后向下搜索；若刚从“过短”翻转而来，把100ms步长细化为10ms，再细化为1ms。
            IF $孵蛋HOME_BUFFER上次方向 == 1 and $孵蛋HOME_BUFFER步长 > 1
                $孵蛋HOME_BUFFER步长 = $孵蛋HOME_BUFFER步长 / 10
            ENDIF
            IF $调试日志输出 == 1
                PRINT HOME_BUFFER延迟过长，减 & $孵蛋HOME_BUFFER步长 & " 继续尝试中"
            ENDIF
            $孵蛋HOME_BUFFER上次方向 = -1
            $HOME_BUFFER延迟 = $HOME_BUFFER延迟 - $孵蛋HOME_BUFFER步长
            IF $HOME_BUFFER延迟 < 100
                PRINT HOME_BUFFER校准失败：延迟已低于100 ms
                $孵蛋HOME_BUFFER失败 = 1
                RETURN
            ENDIF
            X
            WAIT 1500
            A
            WAIT 1500
            FOR
                IF @正在关闭 >= 95
                    WAIT 100
                ELSE
                    BREAK
                ENDIF
            NEXT
            CALL 关闭游戏
        ELSE
            # 保留原版“其他状态视为过短”的规则，只把方向翻转后的步长逐级细化。
            IF $孵蛋HOME_BUFFER上次方向 == -1 and $孵蛋HOME_BUFFER步长 > 1
                $孵蛋HOME_BUFFER步长 = $孵蛋HOME_BUFFER步长 / 10
            ENDIF
            IF $调试日志输出 == 1
                PRINT HOME_BUFFER延迟过短，增 & $孵蛋HOME_BUFFER步长 & " 继续尝试中"
            ENDIF
            $孵蛋HOME_BUFFER上次方向 = 1
            $HOME_BUFFER延迟 = $HOME_BUFFER延迟 + $孵蛋HOME_BUFFER步长
            IF $HOME_BUFFER延迟 > 3000
                PRINT HOME_BUFFER校准失败：延迟已超过3000 ms
                $孵蛋HOME_BUFFER失败 = 1
                RETURN
            ENDIF
            CALL 关闭游戏
        ENDIF
    NEXT
ENDFUNC
