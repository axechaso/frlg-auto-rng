# STARTER_CALIBRATION_GLOBALS_BEGIN
$御三家严格筛选 = 0
$御三家共同证据可信 = 0
$御三家筛选结果 = 0
$御三家候选槽 = 0
$御三家候选归一帧 = 0
$御三家预测帧 = 0
$御三家窗口左宽 = 0
$御三家窗口右宽 = 0
$御三家菜单起始MS = 0
$御三家菜单耗时MS = 0
$御三家F2执行等待MS = 0
# STARTER_CALIBRATION_GLOBALS_END

# STARTER_CALIBRATION_FUNCTIONS_BEGIN
FUNC 御三家准备共同筛选
    $御三家严格筛选 = 0
    $御三家共同证据可信 = 0
    IF $静态或野生 != "孵蛋" and ($目标全国图鉴编号 == 1 or $目标全国图鉴编号 == 4 or $目标全国图鉴编号 == 7)
        $御三家严格筛选 = 1
    ENDIF
    $投票忽略 = 共同区设置严格模式($御三家严格筛选)
ENDFUNC

FUNC 御三家准备反查窗口
    IF $御三家严格筛选 == 0
        RETURN
    ENDIF
    $御三家预测帧 = 共同区预测ADV($目标消耗帧, $消耗帧实际执行修正量)
    IF $御三家预测帧 < 0
        $御三家预测帧 = 0
    ENDIF
    $御三家窗口左宽 = $目标消耗帧 - $最小消耗帧
    $御三家窗口右宽 = $最大消耗帧 - $目标消耗帧
    IF $御三家窗口左宽 < 0
        $御三家窗口左宽 = 0
    ENDIF
    IF $御三家窗口右宽 < 0
        $御三家窗口右宽 = 0
    ENDIF
    IF $御三家窗口左宽 > 500
        $御三家窗口左宽 = 500
    ENDIF
    IF $御三家窗口右宽 > 500
        $御三家窗口右宽 = 500
    ENDIF
    $有效最小消耗帧 = $御三家预测帧 - $御三家窗口左宽
    $有效最大消耗帧 = $御三家预测帧 + $御三家窗口右宽
    IF $有效最小消耗帧 < 0
        $有效最小消耗帧 = 0
    ENDIF
    IF $有效最大消耗帧 < $有效最小消耗帧
        $有效最大消耗帧 = $有效最小消耗帧
    ENDIF
    PRINT 御三家反查执行窗: & $有效最小消耗帧 & - & $有效最大消耗帧 & " ADV；预测中心 " & $御三家预测帧
ENDFUNC

FUNC 御三家计算菜单剩余等待($预算MS: INT, $耗时MS: INT): INT
    IF $耗时MS < 0 or $耗时MS > $预算MS
        RETURN -1
    ENDIF
    RETURN $预算MS - $耗时MS
ENDFUNC

FUNC 御三家应用共同候选(): INT
    $御三家共同证据可信 = 0
    IF $反查算法 != 1 and $反查算法 != 2 and $反查算法 != 4
        PRINT 御三家共同筛选仅支持独立定点方法，本轮不校准
        RETURN 0
    ENDIF
    $御三家候选槽 = 共同区选择本轮配对()
    IF $御三家候选槽 < 0
        PRINT 御三家候选尚未由跨轮共同区消歧：保留完整候选，本轮不校准
        RETURN 0
    ENDIF
    $种子索引 = 共同区取本轮索引($御三家候选槽) - $Seed累计修正索引
    $御三家候选归一帧 = 共同区取本轮ADV($御三家候选槽)
    $当前消耗帧 = $御三家候选归一帧 - $消耗帧实际执行修正量
    IF $种子索引 < 0 or $种子索引 > $Seed最大索引 or $当前消耗帧 < 0
        RETURN 0
    ENDIF
    $当前Seed = 取SeedHEX($游戏版本, $种子索引, $Seed模式)
    $当前MS = 取MS($游戏版本, $种子索引) + $NXSeed平台偏移MS
    $差索引 = $种子索引 - $目标索引
    $候选Seed十进制 = HEX转十进制($当前Seed)
    IF $候选Seed十进制 < 0
        RETURN 0
    ENDIF
    $候HI = 0
    $候LO = $候选Seed十进制
    IF $当前消耗帧 > 0
        FOR $预消耗帧 = 1 TO $当前消耗帧
            $新HI = RNG下一HI($候HI, $候LO)
            $新LO = RNG下一LO($候HI, $候LO)
            $候HI = $新HI
            $候LO = $新LO
        NEXT
    ENDIF
    $当前反查算法 = $反查算法
    CALL 按算法生成个体
    CALL 检查是否匹配
    IF $匹配 != 1
        PRINT 御三家共同候选重新计算未通过识图校验，本轮不校准
        RETURN 0
    ENDIF
    # 复用原距离诊断，不再次收集候选或给同轮加票。
    CALL 御三家刷新候选距离
    CALL 记录当前候选为最佳候选
    $最佳候选离群 = 0
    $最佳候选剩余帧离群 = 0
    $最佳候选Seed离群 = 0
    $最佳候选TV帧离群 = 0
    $本轮真值解 = 0
    IF $本轮候选命中计数 == 1
        $本轮真值解 = 1
    ENDIF
    $御三家共同证据可信 = 1
    PRINT 御三家最终候选: Seed & $当前Seed & " / " & $当前MS & " ms / ADV " & $当前消耗帧 & "；归一ADV " & $御三家候选归一帧 & "；独立唯一 " & $本轮真值解
    CALL 输出最佳命中结果
    RETURN 1
ENDFUNC
# STARTER_CALIBRATION_FUNCTIONS_END
