# GUI 孵蛋运行时覆盖：游戏设置 OCR 使用有限重试，并输出每次原始分数。
# 本文件由 Python 拼接到 1.1.8 的 lib/27_孵蛋测试流程.ecs，不单独执行。

FUNC 孵蛋测试_识别文字速度($识图阈值: INT): INT
    FOR $孵蛋库_设置识别尝试 = 1 TO 3
        $孵蛋库_设置分数1 = @TEXT_SPEED_FAST
        $孵蛋库_设置候选分数 = @日版TEXT_SPEED_FAST
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数1
            $孵蛋库_设置分数1 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数2 = @TEXT_SPEED_MID
        $孵蛋库_设置候选分数 = @日版TEXT_SPEED_MID
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数2
            $孵蛋库_设置分数2 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数3 = @TEXT_SPEED_SLOW
        $孵蛋库_设置候选分数 = @日版TEXT_SPEED_SLOW
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数3
            $孵蛋库_设置分数3 = $孵蛋库_设置候选分数
        ENDIF
        PRINT 设置识别 TEXT 第 & $孵蛋库_设置识别尝试 & "次: FAST=" & $孵蛋库_设置分数1 & " MID=" & $孵蛋库_设置分数2 & " SLOW=" & $孵蛋库_设置分数3

        $孵蛋库_设置最佳分数 = $孵蛋库_设置分数1
        $孵蛋库_设置状态 = 0
        IF $孵蛋库_设置分数2 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数2
            $孵蛋库_设置状态 = 2
        ENDIF
        IF $孵蛋库_设置分数3 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数3
            $孵蛋库_设置状态 = 1
        ENDIF
        IF $孵蛋库_设置最佳分数 >= $识图阈值
            RETURN $孵蛋库_设置状态
        ENDIF
        WAIT 500
    NEXT
    RETURN -1
ENDFUNC

FUNC 孵蛋测试_识别战斗动画($识图阈值: INT): INT
    FOR $孵蛋库_设置识别尝试 = 1 TO 3
        $孵蛋库_设置分数1 = @BATTLE_SCENE_OFF
        $孵蛋库_设置候选分数 = @日版BATTLE_SCENE_OFF
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数1
            $孵蛋库_设置分数1 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数2 = @BATTLE_SCENE_ON
        $孵蛋库_设置候选分数 = @日版BATTLE_SCENE_ON
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数2
            $孵蛋库_设置分数2 = $孵蛋库_设置候选分数
        ENDIF
        PRINT 设置识别 BATTLE 第 & $孵蛋库_设置识别尝试 & "次: OFF=" & $孵蛋库_设置分数1 & " ON=" & $孵蛋库_设置分数2

        $孵蛋库_设置最佳分数 = $孵蛋库_设置分数1
        $孵蛋库_设置状态 = 0
        IF $孵蛋库_设置分数2 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数2
            $孵蛋库_设置状态 = 1
        ENDIF
        IF $孵蛋库_设置最佳分数 >= $识图阈值
            RETURN $孵蛋库_设置状态
        ENDIF
        WAIT 500
    NEXT
    RETURN -1
ENDFUNC

FUNC 孵蛋测试_识别声音($识图阈值: INT): INT
    FOR $孵蛋库_设置识别尝试 = 1 TO 3
        $孵蛋库_设置分数1 = @SOUND_MONO
        $孵蛋库_设置候选分数 = @日版SOUND_MONO
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数1
            $孵蛋库_设置分数1 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数2 = @SOUND_STEREO
        $孵蛋库_设置候选分数 = @日版SOUND_STEREO
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数2
            $孵蛋库_设置分数2 = $孵蛋库_设置候选分数
        ENDIF
        PRINT 设置识别 SOUND 第 & $孵蛋库_设置识别尝试 & "次: MONO=" & $孵蛋库_设置分数1 & " STEREO=" & $孵蛋库_设置分数2

        $孵蛋库_设置最佳分数 = $孵蛋库_设置分数1
        $孵蛋库_设置状态 = 0
        IF $孵蛋库_设置分数2 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数2
            $孵蛋库_设置状态 = 1
        ENDIF
        IF $孵蛋库_设置最佳分数 >= $识图阈值
            RETURN $孵蛋库_设置状态
        ENDIF
        WAIT 500
    NEXT
    RETURN -1
ENDFUNC

FUNC 孵蛋测试_识别按键模式($识图阈值: INT): INT
    FOR $孵蛋库_设置识别尝试 = 1 TO 3
        $孵蛋库_设置分数1 = @BUTTON_MODE_HELP
        $孵蛋库_设置候选分数 = @日版BUTTON_MODE_HELP
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数1
            $孵蛋库_设置分数1 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数2 = @BUTTON_MODE_LA
        $孵蛋库_设置候选分数 = @日版BUTTON_MODE_LA
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数2
            $孵蛋库_设置分数2 = $孵蛋库_设置候选分数
        ENDIF
        $孵蛋库_设置分数3 = @BUTTON_MODE_LR
        $孵蛋库_设置候选分数 = @日版BUTTON_MODE_LR
        IF $孵蛋库_设置候选分数 > $孵蛋库_设置分数3
            $孵蛋库_设置分数3 = $孵蛋库_设置候选分数
        ENDIF
        PRINT 设置识别 BUTTON 第 & $孵蛋库_设置识别尝试 & "次: HELP=" & $孵蛋库_设置分数1 & " L=A=" & $孵蛋库_设置分数2 & " LR=" & $孵蛋库_设置分数3

        $孵蛋库_设置最佳分数 = $孵蛋库_设置分数1
        $孵蛋库_设置状态 = 0
        IF $孵蛋库_设置分数2 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数2
            $孵蛋库_设置状态 = 1
        ENDIF
        IF $孵蛋库_设置分数3 > $孵蛋库_设置最佳分数
            $孵蛋库_设置最佳分数 = $孵蛋库_设置分数3
            $孵蛋库_设置状态 = 2
        ENDIF
        IF $孵蛋库_设置最佳分数 >= $识图阈值
            RETURN $孵蛋库_设置状态
        ENDIF
        WAIT 500
    NEXT
    RETURN -1
ENDFUNC

FUNC 孵蛋测试_检查校正并保存游戏设置($Seed模式: INT, $识图阈值: INT): INT
    $孵蛋库_设置已修改 = 0
    $孵蛋库_目标声音 = 0
    $孵蛋库_目标按键 = 0
    IF $Seed模式 == 1 or $Seed模式 == 3 or $Seed模式 == 6 or $Seed模式 == 7
        $孵蛋库_目标声音 = 1
    ENDIF

    PRINT 【孵蛋准备】按 Seed模式检查游戏设置
    X
    WAIT 500
    FOR 5
        DOWN
        WAIT 150
    NEXT
    A
    WAIT 2000

    $孵蛋库_设置状态 = 孵蛋测试_识别文字速度($识图阈值)
    IF $孵蛋库_设置状态 == 0
        PRINT 文字速度: FAST
    ELIF $孵蛋库_设置状态 == 1
        LEFT
        WAIT 200
        $孵蛋库_设置已修改 = 1
        PRINT 文字速度: SLOW -> FAST
    ELIF $孵蛋库_设置状态 == 2
        RIGHT
        WAIT 200
        $孵蛋库_设置已修改 = 1
        PRINT 文字速度: MID -> FAST
    ELSE
        PRINT 孵蛋设置检查失败: 文字速度连续3次无法识别
        RETURN 0
    ENDIF

    DOWN
    WAIT 200
    $孵蛋库_设置状态 = 孵蛋测试_识别战斗动画($识图阈值)
    IF $孵蛋库_设置状态 == 0
        PRINT 战斗动画: OFF
    ELIF $孵蛋库_设置状态 == 1
        RIGHT
        WAIT 200
        $孵蛋库_设置已修改 = 1
        PRINT 战斗动画: ON -> OFF
    ELSE
        PRINT 孵蛋设置检查失败: 战斗动画连续3次无法识别
        RETURN 0
    ENDIF

    FOR 2
        DOWN
        WAIT 200
    NEXT
    $孵蛋库_设置状态 = 孵蛋测试_识别声音($识图阈值)
    IF $孵蛋库_设置状态 < 0
        PRINT 孵蛋设置检查失败: 声音连续3次无法识别
        RETURN 0
    ENDIF
    IF $孵蛋库_目标声音 == 0
        IF $孵蛋库_设置状态 == 0
            PRINT 声音: MONO
        ELSE
            RIGHT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 声音: STEREO -> MONO
        ENDIF
    ELSE
        IF $孵蛋库_设置状态 == 1
            PRINT 声音: STEREO
        ELSE
            RIGHT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 声音: MONO -> STEREO
        ENDIF
    ENDIF

    DOWN
    WAIT 200
    $孵蛋库_设置状态 = 孵蛋测试_识别按键模式($识图阈值)
    IF $孵蛋库_设置状态 < 0
        PRINT 孵蛋设置检查失败: 按键模式连续3次无法识别
        RETURN 0
    ENDIF
    IF $孵蛋库_目标按键 == 0
        IF $孵蛋库_设置状态 == 0
            PRINT 按键模式: HELP
        ELIF $孵蛋库_设置状态 == 1
            RIGHT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 按键模式: L=A -> HELP
        ELSE
            LEFT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 按键模式: LR -> HELP
        ENDIF
    ELSE
        IF $孵蛋库_设置状态 == 2
            PRINT 按键模式: LR
        ELIF $孵蛋库_设置状态 == 1
            LEFT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 按键模式: L=A -> LR
        ELSE
            RIGHT
            WAIT 200
            $孵蛋库_设置已修改 = 1
            PRINT 按键模式: HELP -> LR
        ENDIF
    ENDIF

    # 254 步状态必须落盘，所以设置正确时也强制保存。
    B
    WAIT 1500
    UP
    WAIT 200
    A
    WAIT 1000
    A
    WAIT 1500
    A
    WAIT 3000
    IF $孵蛋库_设置已修改 == 1
        PRINT 【孵蛋准备】设置已校正，并在 254 步位置存档
    ELSE
        PRINT 【孵蛋准备】设置正确，并在 254 步位置存档
    ENDIF
    RETURN 1
ENDFUNC
