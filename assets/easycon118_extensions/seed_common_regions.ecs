$C_sortwidth = 0
$C_sortbase = 0
$C_sortmid = 0
$C_sortstop = 0
$C_sortleft = 0
$C_sortright = 0
$C_sortout = 0
$C_sortchoose = 0
$C_sortlID = 0
$C_sortrID = 0

FUNC 共同区重置
    $C_轮数 = 0
    $C_写轮 = 0
    $C_重复数 = 0
    $C_最佳覆盖 = 0
    $C_可用 = 0
    $C_坏轮 = 0
    $C_最近评分生效 = 0
    FOR $C_i = 0 TO 11
        $C_轮长度[$C_i] = 0
    NEXT
    CALL 共同区开始扫描
ENDFUNC

FUNC 共同区开始扫描
    $C_本数 = 0
    $C_本坏 = 0
    $C_本提交 = 0
ENDFUNC

# 容量只限制诊断缓存，不限制原反查；越界整轮不参与，绝不截掉后冒充完整结果。
FUNC 共同区收集($游戏: INT, $实际索引: INT, $Seed累计: INT, $实际ADV: INT, $帧累计: INT, $平台MS: INT): INT
    $C_tmp = $实际索引 + $Seed累计
    $C_end = 取Seed最大索引($游戏)
    IF $C_tmp < 0 or $C_tmp > $C_end
        $C_本坏 = 1
        RETURN 0
    ENDIF
    $C_m = 取MS($游戏, $C_tmp) + $平台MS
    $C_t = $实际ADV + $帧累计
    RETURN 共同区收集配对($C_m, $C_t, $C_tmp)
ENDFUNC

FUNC 共同区收集配对($MS: INT, $ADV: INT, $索引: INT): INT
    $C_末 = $C_本数 - 1
    FOR $C_i = 0 TO $C_末
        IF $C_本Seed[$C_i] == $MS and $C_本ADV[$C_i] == $ADV and $C_本索引[$C_i] == $索引
            RETURN 1
        ENDIF
    NEXT
    IF $C_本数 >= 200
        $C_本坏 = 1
        RETURN 0
    ENDIF
    # 按 Seed/ADV/索引排序，完整内容比较不依赖输入顺序或弱签名。
    $C_j = $C_本数
    FOR
        IF $C_j <= 0
            BREAK
        ENDIF
        $C_k = $C_j - 1
        IF $C_本Seed[$C_k] < $MS
            BREAK
        ENDIF
        IF $C_本Seed[$C_k] == $MS and $C_本ADV[$C_k] < $ADV
            BREAK
        ENDIF
        IF $C_本Seed[$C_k] == $MS and $C_本ADV[$C_k] == $ADV and $C_本索引[$C_k] <= $索引
            BREAK
        ENDIF
        $C_本Seed[$C_j] = $C_本Seed[$C_k]
        $C_本ADV[$C_j] = $C_本ADV[$C_k]
        $C_本索引[$C_j] = $C_本索引[$C_k]
        $C_j = $C_k
    NEXT
    $C_本Seed[$C_j] = $MS
    $C_本ADV[$C_j] = $ADV
    $C_本索引[$C_j] = $索引
    $C_本数 = $C_本数 + 1
    RETURN 1
ENDFUNC

# 主脚本只在一只宝可梦的吃糖细分结束后提交最终扫描，扩窗/同只吃糖不是新一轮。
FUNC 共同区提交(): INT
    IF $C_本提交 == 1
        RETURN 0
    ENDIF
    $C_本提交 = 1
    IF $C_本坏 == 1 or $C_本数 == 0
        $C_坏轮 = 1
        $C_可用 = 0
        PRINT 共同紧密区: 本轮候选不完整或为空，仅诊断，不参与排序
        RETURN 0
    ENDIF
    FOR $C_r = 0 TO 11
        IF $C_轮长度[$C_r] != $C_本数
            CONTINUE
        ENDIF
        $C_same = 1
        $C_末 = $C_本数 - 1
        FOR $C_i = 0 TO $C_末
            $C_p = $C_r * 200 + $C_i
            IF $C_史Seed[$C_p] != $C_本Seed[$C_i] or $C_史ADV[$C_p] != $C_本ADV[$C_i] or $C_史索引[$C_p] != $C_本索引[$C_i]
                $C_same = 0
                BREAK
            ENDIF
        NEXT
        IF $C_same == 1
            $C_重复数 = $C_重复数 + 1
            PRINT 共同紧密区: 完全相同的配对集合，不增加覆盖轮数
            RETURN 0
        ENDIF
    NEXT
    $C_末 = $C_本数 - 1
    FOR $C_i = 0 TO $C_末
        $C_p = $C_写轮 * 200 + $C_i
        $C_史Seed[$C_p] = $C_本Seed[$C_i]
        $C_史ADV[$C_p] = $C_本ADV[$C_i]
        $C_史索引[$C_p] = $C_本索引[$C_i]
        IF $共同区输出配对 == 1
            $C_tmp = $C_本Seed[$C_i]
            $C_m = $C_本ADV[$C_i]
            $C_t = $C_本索引[$C_i]
            PRINT COMMON_PAIR|SLOT= & $C_写轮 & |SEED_MS= & $C_tmp & |ADV= & $C_m & |INDEX= & $C_t
        ENDIF
    NEXT
    $C_轮长度[$C_写轮] = $C_本数
    $C_写轮 = ($C_写轮 + 1) % 12
    IF $C_轮数 < 12
        $C_轮数 = $C_轮数 + 1
    ENDIF
    $C_坏轮 = 0
    CALL 共同区重算
    CALL 共同区打印
    RETURN 1
ENDFUNC

# 以两个排序视图扫描矩形。不是连通分量，不把两轮范围先压成各轴的独立区间。
FUNC 共同区重算
    $C_点数 = 0
    $C_最佳覆盖 = 0
    $C_最佳Seed跨度 = 0
    $C_最佳ADV跨度 = 0
    $C_歧义 = 0
    $C_可用 = 0
    $C_工作量 = 0
    $C_超限 = 0
    IF $共同区Seed总跨度 < 0 or $共同区ADV总跨度 < 0
        RETURN
    ENDIF
    FOR $C_r = 0 TO 11
        $C_末 = $C_轮长度[$C_r] - 1
        FOR $C_i = 0 TO $C_末
            $C_p = $C_r * 200 + $C_i
            $C_X序[$C_点数] = $C_p
            $C_Y序[$C_点数] = $C_p
            $C_点数 = $C_点数 + 1
        NEXT
    NEXT
    $C_忽略 = 共同区排序(0)
    $C_忽略 = 共同区排序(1)
    $C_end = $C_点数 - 1
    FOR $C_anchor = 0 TO $C_end
        $C_p = $C_X序[$C_anchor]
        $C_xlow = $C_史Seed[$C_p]
        IF $C_anchor > 0
            $C_k = $C_anchor - 1
            $C_q = $C_X序[$C_k]
            IF $C_xlow == $C_史Seed[$C_q]
                CONTINUE
            ENDIF
        ENDIF
        $C_xhigh = $C_xlow + $共同区Seed总跨度
        $C_count = 0
        $C_left = 0
        $C_cover = 0
        FOR $C_r = 0 TO 11
            $C_Y票[$C_r] = 0
        NEXT
        FOR $C_n = 0 TO $C_end
            $C_p = $C_Y序[$C_n]
            IF $C_史Seed[$C_p] < $C_xlow or $C_史Seed[$C_p] > $C_xhigh
                CONTINUE
            ENDIF
            $C_Y窗[$C_count] = $C_p
            $C_count = $C_count + 1
            # 整除不能依赖运行器的四舍五入策略。
            $C_r = ($C_p - $C_p % 200) / 200
            IF $C_Y票[$C_r] == 0
                $C_cover = $C_cover + 1
            ENDIF
            $C_Y票[$C_r] = $C_Y票[$C_r] + 1
            $C_yhigh = $C_史ADV[$C_p]
            FOR
                $C_q = $C_Y窗[$C_left]
                $C_r = ($C_q - $C_q % 200) / 200
                IF $C_yhigh - $C_史ADV[$C_q] <= $共同区ADV总跨度 and $C_Y票[$C_r] <= 1
                    BREAK
                ENDIF
                $C_Y票[$C_r] = $C_Y票[$C_r] - 1
                IF $C_Y票[$C_r] == 0
                    $C_cover = $C_cover - 1
                ENDIF
                $C_left = $C_left + 1
            NEXT
            $C_ylow = $C_史ADV[$C_q]
            IF $C_cover < $C_最佳覆盖
                CONTINUE
            ENDIF
            $C_span = $C_yhigh - $C_ylow
            CALL 共同区评价矩形
            IF $C_超限 == 1
                RETURN
            ENDIF
        NEXT
    NEXT
    IF $C_包络Seed高 - $C_包络Seed低 > $共同区Seed总跨度 or $C_包络ADV高 - $C_包络ADV低 > $共同区ADV总跨度
        $C_歧义 = 1
    ENDIF
    # 至少三轮、严格多数、无分离解释；只给后续候选加距离，不替代任何校准公式。
    IF $共同区参与排序 == 1 and $C_最佳覆盖 >= 3 and $C_最佳覆盖 * 2 > $C_轮数 and $C_歧义 == 0
        $C_可用 = 1
    ENDIF
ENDFUNC

# 底向上归并排序，2400 个候选也不做全表插入排序。
FUNC 共同区排序($轴: INT): INT
    $C_sortwidth = 1
    FOR
        IF $C_sortwidth >= $C_点数
            BREAK
        ENDIF
        $C_sortbase = 0
        FOR
            IF $C_sortbase >= $C_点数
                BREAK
            ENDIF
            $C_sortmid = $C_sortbase + $C_sortwidth
            $C_sortstop = $C_sortmid + $C_sortwidth
            IF $C_sortmid > $C_点数
                $C_sortmid = $C_点数
            ENDIF
            IF $C_sortstop > $C_点数
                $C_sortstop = $C_点数
            ENDIF
            $C_sortleft = $C_sortbase
            $C_sortright = $C_sortmid
            $C_sortout = $C_sortbase
            FOR
                IF $C_sortout >= $C_sortstop
                    BREAK
                ENDIF
                $C_sortchoose = 0
                IF $C_sortright >= $C_sortstop
                    $C_sortchoose = 1
                ELIF $C_sortleft < $C_sortmid
                    IF $轴 == 0
                        $C_sortlID = $C_X序[$C_sortleft]
                        $C_sortrID = $C_X序[$C_sortright]
                        IF $C_史Seed[$C_sortlID] <= $C_史Seed[$C_sortrID]
                            $C_sortchoose = 1
                        ENDIF
                    ELSE
                        $C_sortlID = $C_Y序[$C_sortleft]
                        $C_sortrID = $C_Y序[$C_sortright]
                        IF $C_史ADV[$C_sortlID] <= $C_史ADV[$C_sortrID]
                            $C_sortchoose = 1
                        ENDIF
                    ENDIF
                ENDIF
                IF $C_sortchoose == 1
                    IF $轴 == 0
                        $C_排序缓冲[$C_sortout] = $C_X序[$C_sortleft]
                    ELSE
                        $C_排序缓冲[$C_sortout] = $C_Y序[$C_sortleft]
                    ENDIF
                    $C_sortleft = $C_sortleft + 1
                ELSE
                    IF $轴 == 0
                        $C_排序缓冲[$C_sortout] = $C_X序[$C_sortright]
                    ELSE
                        $C_排序缓冲[$C_sortout] = $C_Y序[$C_sortright]
                    ENDIF
                    $C_sortright = $C_sortright + 1
                ENDIF
                $C_sortout = $C_sortout + 1
            NEXT
            $C_sortbase = $C_sortstop
        NEXT
        $C_末 = $C_点数 - 1
        FOR $C_i = 0 TO $C_末
            IF $轴 == 0
                $C_X序[$C_i] = $C_排序缓冲[$C_i]
            ELSE
                $C_Y序[$C_i] = $C_排序缓冲[$C_i]
            ENDIF
        NEXT
        $C_sortwidth = $C_sortwidth * 2
    NEXT
    RETURN 1
ENDFUNC

FUNC 共同区记录解释包络
    IF $C_cover > $C_最佳覆盖
        $C_包络Seed低 = $C_xmin
        $C_包络Seed高 = $C_xmax
        $C_包络索引低 = $C_imin
        $C_包络索引高 = $C_imax
        $C_包络ADV低 = $C_ylow
        $C_包络ADV高 = $C_yhigh
    ELSE
        IF $C_xmin < $C_包络Seed低
            $C_包络Seed低 = $C_xmin
            $C_包络索引低 = $C_imin
        ENDIF
        IF $C_xmax > $C_包络Seed高
            $C_包络Seed高 = $C_xmax
            $C_包络索引高 = $C_imax
        ENDIF
        IF $C_ylow < $C_包络ADV低
            $C_包络ADV低 = $C_ylow
        ENDIF
        IF $C_yhigh > $C_包络ADV高
            $C_包络ADV高 = $C_yhigh
        ENDIF
    ENDIF
ENDFUNC

# 对给定 ADV 窗，找能覆盖同样轮数的最窄 Seed 窗。
# 每轮可能有多个配对，但覆盖只计一次；输出窗口必须包含真实配对。
FUNC 共同区评价矩形
    # 二分定位 ADV 下界，只遍历本矩形的真实配对。
    # 包括与左右边界同 ADV 的全部配对，不能丢掉同一轮更窄的 Seed 选择。
    $C_start = 0
    $C_right = $C_点数
    FOR
        IF $C_start >= $C_right
            BREAK
        ENDIF
        $C_mid = $C_start + $C_right
        $C_mid = ($C_mid - $C_mid % 2) / 2
        $C_p = $C_Y序[$C_mid]
        IF $C_史ADV[$C_p] < $C_ylow
            $C_start = $C_mid + 1
        ELSE
            $C_right = $C_mid
        ENDIF
    NEXT
    $C_xcount = 0
    $C_xmin = 2147483647
    $C_xmax = 0 - 2147483647
    $C_imin = 2147483647
    $C_imax = 0 - 2147483647
    FOR $C_m = $C_start TO $C_end
        $C_工作量 = $C_工作量 + 1
        IF $C_工作量 > 2000000
            $C_超限 = 1
            $C_可用 = 0
            RETURN
        ENDIF
        $C_p = $C_Y序[$C_m]
        IF $C_史ADV[$C_p] > $C_yhigh
            BREAK
        ENDIF
        IF $C_史Seed[$C_p] < $C_xlow or $C_史Seed[$C_p] > $C_xhigh
            CONTINUE
        ENDIF
        $C_X窗[$C_xcount] = $C_p
        $C_xcount = $C_xcount + 1
        IF $C_史Seed[$C_p] < $C_xmin
            $C_xmin = $C_史Seed[$C_p]
        ENDIF
        IF $C_史Seed[$C_p] > $C_xmax
            $C_xmax = $C_史Seed[$C_p]
        ENDIF
        IF $C_史索引[$C_p] < $C_imin
            $C_imin = $C_史索引[$C_p]
        ENDIF
        IF $C_史索引[$C_p] > $C_imax
            $C_imax = $C_史索引[$C_p]
        ENDIF
    NEXT
    CALL 共同区记录解释包络
    IF $C_cover == $C_最佳覆盖 and $C_span > $C_最佳ADV跨度
        RETURN
    ENDIF
    IF $C_xcount == $C_cover
        CALL 共同区记录最优窗口
        RETURN
    ENDIF
    # 对给定 ADV 窗，用第二个滑窗找同覆盖的最小 Seed 总跨度。
    $C_末 = $C_xcount - 1
    FOR $C_i = 1 TO $C_末
        $C_p = $C_X窗[$C_i]
        $C_j = $C_i
        FOR
            IF $C_j <= 0
                BREAK
            ENDIF
            $C_k = $C_j - 1
            $C_q = $C_X窗[$C_k]
            IF $C_史Seed[$C_q] <= $C_史Seed[$C_p]
                BREAK
            ENDIF
            $C_X窗[$C_j] = $C_q
            $C_j = $C_k
        NEXT
        $C_X窗[$C_j] = $C_p
    NEXT
    $C_xleft = 0
    $C_xcover = 0
    FOR $C_r = 0 TO 11
        $C_X票[$C_r] = 0
    NEXT
    FOR $C_i = 0 TO $C_末
        $C_p = $C_X窗[$C_i]
        $C_r = ($C_p - $C_p % 200) / 200
        IF $C_X票[$C_r] == 0
            $C_xcover = $C_xcover + 1
        ENDIF
        $C_X票[$C_r] = $C_X票[$C_r] + 1
        FOR
            $C_q = $C_X窗[$C_xleft]
            $C_r = ($C_q - $C_q % 200) / 200
            IF $C_X票[$C_r] <= 1
                BREAK
            ENDIF
            $C_X票[$C_r] = $C_X票[$C_r] - 1
            $C_xleft = $C_xleft + 1
        NEXT
        IF $C_xcover != $C_cover
            CONTINUE
        ENDIF
        $C_xmin = $C_史Seed[$C_q]
        $C_xmax = $C_史Seed[$C_p]
        CALL 共同区记录最优窗口
    NEXT
ENDFUNC

FUNC 共同区记录最优窗口
    $C_found = 0
    IF $C_cover > $C_最佳覆盖
        $C_found = 1
    ELIF $C_span < $C_最佳ADV跨度
        $C_found = 1
    ELIF $C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin < $C_最佳Seed跨度
        $C_found = 1
    ELIF $C_span == $C_最佳ADV跨度 and $C_xmax - $C_xmin == $C_最佳Seed跨度 and $C_xmin < $C_最佳Seed低
        $C_found = 1
    ENDIF
    IF $C_found == 1
        $C_最佳覆盖 = $C_cover
        $C_最佳Seed跨度 = $C_xmax - $C_xmin
        $C_最佳ADV跨度 = $C_span
        $C_最佳Seed低 = $C_xmin
        $C_最佳Seed高 = $C_xmax
        $C_最佳ADV低 = $C_ylow
        $C_最佳ADV高 = $C_yhigh
    ENDIF
ENDFUNC

FUNC 共同区候选加权距离($基准索引: INT, $基准ADV: INT, $Seed权重: INT, $ADV权重: INT): INT
    $C_最近评分生效 = 0
    IF $C_可用 == 0 or $C_坏轮 == 1
        RETURN 0
    ENDIF
    $C_最近评分生效 = 1
    $C_dx = 0
    $C_dy = 0
    IF $基准索引 < $C_包络索引低
        $C_dx = $C_包络索引低 - $基准索引
    ELIF $基准索引 > $C_包络索引高
        $C_dx = $基准索引 - $C_包络索引高
    ENDIF
    IF $基准ADV < $C_包络ADV低
        $C_dy = $C_包络ADV低 - $基准ADV
    ELIF $基准ADV > $C_包络ADV高
        $C_dy = $基准ADV - $C_包络ADV高
    ENDIF
    RETURN 候选MSE评分($C_dx, $C_dy, $Seed权重, $ADV权重)
ENDFUNC

FUNC 共同区打印
    PRINT 共同紧密区|独立轮= & $C_轮数 & /12|重复集= & $C_重复数 & |Seed总跨度上限= & $共同区Seed总跨度 & ms|ADV总跨度上限= & $共同区ADV总跨度
    IF $C_超限 == 1 or $C_坏轮 == 1
        PRINT 共同紧密区: 候选缓存或计算不完整，不参与排序
        RETURN
    ENDIF
    IF $C_最佳覆盖 == 0
        PRINT 共同紧密区: 暂无完整候选
        RETURN
    ENDIF
    PRINT 排名首位共同紧密区|覆盖= & $C_最佳覆盖 & / & $C_轮数 & |归一SeedMS= & $C_最佳Seed低 & - & $C_最佳Seed高 & |归一ADV= & $C_最佳ADV低 & - & $C_最佳ADV高
    # 中心/半跨度用 .0/.5 无损表示，避免 INT 除法吞掉半帧。
    $C_中心Seed2 = $C_最佳Seed低 + $C_最佳Seed高
    $C_中心ADV2 = $C_最佳ADV低 + $C_最佳ADV高
    $C_Seed中心整 = ($C_中心Seed2 - $C_中心Seed2 % 2) / 2
    $C_Seed中心小数 = ($C_中心Seed2 % 2) * 5
    $C_tmp = $C_中心ADV2
    IF $C_tmp < 0
        $C_tmp = 0 - $C_tmp
    ENDIF
    $C_ADV中心整 = ($C_tmp - $C_tmp % 2) / 2
    $C_ADV中心小数 = ($C_tmp % 2) * 5
    $C_Seed半跨度整 = ($C_最佳Seed跨度 - $C_最佳Seed跨度 % 2) / 2
    $C_Seed半跨度小数 = ($C_最佳Seed跨度 % 2) * 5
    $C_ADV半跨度整 = ($C_最佳ADV跨度 - $C_最佳ADV跨度 % 2) / 2
    $C_ADV半跨度小数 = ($C_最佳ADV跨度 % 2) * 5
    PRINT Seed中心= & $C_Seed中心整 & . & $C_Seed中心小数 & ms|最大偏差=± & $C_Seed半跨度整 & . & $C_Seed半跨度小数 & ms
    IF $C_中心ADV2 < 0
        PRINT ADV中心=- & $C_ADV中心整 & . & $C_ADV中心小数 & |最大偏差=± & $C_ADV半跨度整 & . & $C_ADV半跨度小数
    ELSE
        PRINT ADV中心= & $C_ADV中心整 & . & $C_ADV中心小数 & |最大偏差=± & $C_ADV半跨度整 & . & $C_ADV半跨度小数
    ENDIF
    PRINT 共同紧密区判定|存在分离解释= & $C_歧义 & |下轮参与排序= & $C_可用 & |本轮扫描使用= & $C_最近评分生效
    PRINT 注意: 全部为撤销累计修正后的共同坐标；排名首位不是最终真值，不直接生成Seed或帧修正
ENDFUNC
# SEED_COMMON_REGION_V1_END
