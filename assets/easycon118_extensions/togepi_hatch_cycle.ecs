# 1.6.4-a 波克比专用孵化执行：按14步循环骑车，不再读取蛋孵化标签。
# 本文件由 Python 替换到 1.1.8 的 lib/16_获取_静态目标.ecs，不单独执行。

# 仅供定点波克比使用；共享孵蛋流程仍使用 lib/27 的38步循环。
$波克比专用孵化循环数 = 0
$波克比专用孵化循环索引 = 0

FUNC 获取波克比_执行专用骑车($目标全国图鉴编号: INT): INT
    # 波克比属于10孵化周期；第三世代额外周期和1轮安全余量沿用既有计算。
    $波克比专用孵化循环数 = 孵蛋测试_计算孵化循环数($目标全国图鉴编号, 0, 14, 1)
    IF $波克比专用孵化循环数 <= 0
        PRINT 波克比专用骑车循环参数无效
        RETURN 0
    ENDIF

    PRINT 【波克比】按14步循环开始骑车
    FOR $波克比专用孵化循环索引 = 1 TO $波克比专用孵化循环数
        IF $波克比专用孵化循环索引 == 1 or $波克比专用孵化循环索引 % 10 == 0 or $波克比专用孵化循环索引 == $波克比专用孵化循环数
            PRINT 波克比骑车进度: & $波克比专用孵化循环索引 & "/" & $波克比专用孵化循环数
        ENDIF
        LS UP
        1300
        LS RESET
        WAIT 300
        LS DOWN
        1300
        LS RESET
    NEXT

    # 保留原定点波克比的固定收尾，不依赖蛋孵化标签。
    WAIT 500
    B
    WAIT 12000
    B
    WAIT 1500
    B
    WAIT 1500
    RETURN 1
ENDFUNC

# 175: 波克比 / Togepi
FUNC 获取波克比($F2: INT, $目标全国图鉴编号: INT, $进入TV: INT): INT
    $F2执行 = $F2
    A
    WAIT 1500
    B
    WAIT 1500
    B
    WAIT 1500
    B
    WAIT 1500
    B
    WAIT 1500
    B
    WAIT 1500
    IF $计数 == 0
        $计数 = 1
        $time_F2 = TIME()
        RETURN $time_F2
    ENDIF
    $静态目标时间轴超时 = 静态目标等待F2($F2执行)
    A
    WAIT 3000
    B
    WAIT 1500
    B
    WAIT 1000
    IF $进入TV == 0
        Y
        WAIT 500
    ELSE
        X
        WAIT 500
        DOWN
        WAIT 500
        DOWN
        WAIT 500
        A
        WAIT 1500
        RIGHT
        WAIT 1500
        FOR 3
            DOWN
            WAIT 500
        NEXT
        A
        WAIT 500
        A
        WAIT 1500
    ENDIF

    RETURN 获取波克比_执行专用骑车($目标全国图鉴编号)
ENDFUNC
