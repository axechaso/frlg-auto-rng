# TID 1.3.7 HOME_BUFFER 稳定低分自适应：仅由工具显式开启。
FUNC TID_HOME_BUFFER识别稳定状态(): INT
    $HOME_BUFFER自适应首次状态 = 0
    $HOME_BUFFER自适应首次分数 = 0

    FOR $HOME_BUFFER自适应采样 = 1 TO $HOME_BUFFER自适应稳定要求
        IF $HOME_BUFFER自适应采样 > 1
            WAIT 200
        ENDIF

        IF $NS机型 == 1
            $HOME_BUFFER选中正确 = @HOME_BUFFER正确退出
            $HOME_BUFFER选中普通 = @正确退出
            $HOME_BUFFER选中错误 = @错误退出
        ELSE
            $HOME_BUFFER选中正确 = @HOME_BUFFER正确退出_NS2
            $HOME_BUFFER选中普通 = @正确退出_NS2
            $HOME_BUFFER选中错误 = @错误退出_NS2
        ENDIF

        PRINT "TID_HOME_BUFFER_LABEL|NX=" & $NS机型 & "|BUFFER=" & $HOME_BUFFER选中正确 & "|NORMAL=" & $HOME_BUFFER选中普通 & "|ERROR=" & $HOME_BUFFER选中错误 & "|THRESHOLD=" & $HOME_BUFFER有效识图阈值 & "|SAMPLE=" & $HOME_BUFFER自适应采样

        # 保持原 1.3.7 的判断优先级：BUFFER、ERROR、NORMAL。
        IF $HOME_BUFFER选中正确 >= $HOME_BUFFER有效识图阈值
            RETURN 1
        ELIF $HOME_BUFFER选中错误 >= $HOME_BUFFER有效识图阈值
            RETURN 3
        ELIF $HOME_BUFFER选中普通 >= $HOME_BUFFER有效识图阈值
            RETURN 2
        ENDIF

        # 低分自适应只接受唯一最高标签；并列或低于90分均拒绝。
        $HOME_BUFFER自适应候选状态 = 0
        $HOME_BUFFER自适应候选分数 = 0
        IF $HOME_BUFFER选中正确 > $HOME_BUFFER选中普通 and $HOME_BUFFER选中正确 > $HOME_BUFFER选中错误
            $HOME_BUFFER自适应候选状态 = 1
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中正确
        ELIF $HOME_BUFFER选中错误 > $HOME_BUFFER选中正确 and $HOME_BUFFER选中错误 > $HOME_BUFFER选中普通
            $HOME_BUFFER自适应候选状态 = 3
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中错误
        ELIF $HOME_BUFFER选中普通 > $HOME_BUFFER选中正确 and $HOME_BUFFER选中普通 > $HOME_BUFFER选中错误
            $HOME_BUFFER自适应候选状态 = 2
            $HOME_BUFFER自适应候选分数 = $HOME_BUFFER选中普通
        ELSE
            RETURN 0
        ENDIF

        IF $HOME_BUFFER自适应候选分数 < $HOME_BUFFER自适应最低阈值
            RETURN 0
        ENDIF
        IF $HOME_BUFFER自适应采样 == 1
            $HOME_BUFFER自适应首次状态 = $HOME_BUFFER自适应候选状态
            $HOME_BUFFER自适应首次分数 = $HOME_BUFFER自适应候选分数
        ELIF $HOME_BUFFER自适应候选状态 != $HOME_BUFFER自适应首次状态 or $HOME_BUFFER自适应候选分数 != $HOME_BUFFER自适应首次分数
            RETURN 0
        ENDIF
    NEXT

    $HOME_BUFFER有效识图阈值 = $HOME_BUFFER自适应首次分数
    PRINT "TID_HOME_BUFFER_ADAPTIVE|OLD=95|NEW=" & $HOME_BUFFER有效识图阈值 & "|STATE=" & $HOME_BUFFER自适应首次状态 & "|STABLE=" & $HOME_BUFFER自适应稳定要求
    RETURN $HOME_BUFFER自适应首次状态
ENDFUNC

FUNC HOME_BUFFER
    FOR
        A
        1500
        A
        WAIT $HOME_BUFFER延迟
        PRINT 尝试HOME_BUFFER延迟: & $HOME_BUFFER延迟 & " ms"
        HOME 100
        1500
        $HOME_BUFFER识别状态 = TID_HOME_BUFFER识别稳定状态()
        IF $HOME_BUFFER识别状态 == 1
            PRINT HOME_BUFFER正确
            PRINT 可用HOME_BUFFER延迟: & $HOME_BUFFER延迟 & " ms"
            RETURN
        ELIF $HOME_BUFFER识别状态 == 3
            PRINT 错误进入休眠菜单
            B
            1000
            CALL 关闭游戏
        ELIF $HOME_BUFFER识别状态 == 2
            PRINT HOME_BUFFER延迟过长，减100继续尝试中
            CALL 关闭游戏
            $HOME_BUFFER延迟 -= 100
        ELSE
            PRINT HOME_BUFFER延迟过短，加100继续尝试中
            $HOME_BUFFER延迟 += 100
        ENDIF
    NEXT
ENDFUNC
